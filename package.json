{
  "name": "keyli-macos-app",
  "version": "1.0.2",
  "private": true,
  "description": "Modern macOS Keyboard Viewer & Interactive Keyboard",
  "scripts": {
    "build": "./Scripts/build.sh",
    "test": "./Scripts/swift-package.sh test",
    "clean": "swift package clean && rm -rf .build/Keyli.app",
    "install": "npm run build && mkdir -p \"$HOME/Applications\" && ditto .build/Keyli.app \"$HOME/Applications/Keyli.app\"",
    "open": "open \"$HOME/Applications/Keyli.app\"",
    "ship": "./Scripts/ship.sh",
    "bump": "./Scripts/bump-version.sh",
    "start": "npm run ship"
  }
}
